{
  "version": 2,
  "builds": [
    {
      "src": "rastaurant/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{venv/**,.venv/**,db.sqlite3,db.sqlite,staticfiles/**}"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles_build" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "(.*)",
      "dest": "rastaurant/wsgi.py"
    }
  ]
}